{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "import/no-cycle": "error",
    "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    {
      "files": ["src/types/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../config/**", "**/utils/**", "**/data/**", "../content/**", "**/services/**", "**/stores/**", "**/hooks/**", "**/components/**", "**/views/**", "**/router/**"],
                "message": "DEC-R012: Layer 'types' cannot import from other layers."
              },
              {
                "group": ["@react-three/**"],
                "message": "Layer 'types' cannot import from '@react-three/*'."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/config/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/data/**", "../content/**", "**/services/**", "**/stores/**", "**/hooks/**", "**/components/**", "**/views/**", "**/router/**"],
                "message": "DEC-R012: Layer 'config' may only import from 'types' and 'utils'."
              },
              {
                "group": ["three", "three/**", "@react-three/**"],
                "message": "Layer 'config' cannot import Three.js or React Three Fiber."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/utils/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/data/**", "../content/**", "**/services/**", "**/stores/**", "**/hooks/**", "**/components/**", "**/views/**", "**/router/**"],
                "message": "DEC-R012: Layer 'utils' may only import from 'types' and 'config'."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/data/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/services/**", "**/stores/**", "**/hooks/**", "**/components/**", "**/views/**", "**/router/**"],
                "message": "DEC-R012: Layer 'data' may only import from 'types', 'config', and 'utils'."
              },
              {
                "group": ["three", "three/**", "@react-three/**"],
                "message": "Layer 'data' cannot import Three.js or React Three Fiber."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/content/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/services/**", "**/stores/**", "**/hooks/**", "**/components/**", "**/views/**", "**/router/**"],
                "message": "DEC-R012: Layer 'content' may only import from 'types', 'config', 'utils', and 'data'."
              },
              {
                "group": ["three", "three/**", "@react-three/**"],
                "message": "Layer 'content' cannot import Three.js or React Three Fiber."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/services/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/stores/**", "**/hooks/**", "**/components/**", "**/views/**", "**/router/**"],
                "message": "DEC-R012: Layer 'services' may only import from 'types', 'config', 'utils', 'data', and 'content'."
              },
              {
                "group": ["three", "three/**", "@react-three/**"],
                "message": "Layer 'services' cannot import Three.js or React Three Fiber."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/stores/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/hooks/**", "**/components/**", "**/views/**", "**/router/**"],
                "message": "DEC-R012: Layer 'stores' cannot import from 'hooks', 'components', 'views', or 'router'."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/stores/**"],
      "excludeFiles": ["**/*.test.*", "**/*.stories.*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/hooks/**", "**/components/**", "**/views/**", "**/router/**"],
                "message": "DEC-R012: Layer 'stores' cannot import from 'hooks', 'components', 'views', or 'router'."
              },
              {
                "group": ["three", "three/**", "@react-three/**"],
                "message": "Layer 'stores' cannot import Three.js or React Three Fiber."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/hooks/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/components/**", "**/views/**", "**/router/**"],
                "message": "DEC-R012: Layer 'hooks' cannot import from 'components', 'views', or 'router'."
              },
              {
                "group": ["three", "three/**", "@react-three/**"],
                "message": "Layer 'hooks' cannot import Three.js or React Three Fiber."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/interface/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/data/**", "**/content/**", "**/services/**", "**/stores/**", "**/canvas/**", "**/domain/**", "**/views/**", "**/router/**"],
                "message": "DEC-R012: Layer 'components/interface' may only import from 'types', 'config', 'utils', and 'hooks'."
              },
              {
                "group": ["three", "three/**", "@react-three/**"],
                "message": "Layer 'components/interface' cannot import Three.js or React Three Fiber."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/canvas/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/domain/**", "**/views/**", "**/router/**"],
                "message": "DEC-R012: Layer 'components/canvas' cannot import from 'domain', 'views', or 'router'."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/views/**", "**/router/**"],
                "message": "DEC-R012: Domain and search components cannot import from 'views' or 'router'."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/views/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/router/**"],
                "message": "DEC-R012: Layer 'views' cannot import from 'router'."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.stories.ts",
        "**/*.stories.tsx",
        "tests/**",
        "e2e/**",
        "scripts/**",
        "content/**"
      ],
      "rules": {
        "max-lines": "off",
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}
