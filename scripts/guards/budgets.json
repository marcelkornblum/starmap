{
  "suppressions": {
    "guardDisable": 0,
    "r3fAuditDisable": 0,
    "uiAuditDisable": 4,
    "eslintDisable": 5,
    "oxlintDisable": 0,
    "tsIgnoreOrExpectError": 0
  },
  "data": {
    "maxTotalBytes": 52428800,
    "maxStartupSearchBytes": 1572864,
