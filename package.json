{
  "name": "starmap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "build:all": "npm run data:pipeline && npm run typecheck && npm run build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "audit:guards": "tsx scripts/audit-guards.ts",
    "audit:r3f": "tsx scripts/audit-r3f.ts",
    "audit:ui": "tsx scripts/audit-ui.ts",
    "audit:budgets": "tsx scripts/audit-budgets.ts",
    "audit:bundle": "tsx scripts/audit-budgets.ts --bundle",
    "check": "npm run lint && npm run typecheck && npm run audit:guards && npm run audit:ui && npm run audit:r3f && npm run audit:budgets",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "STORYBOOK_TEST=1 vitest run --project=storybook",
    "test:e2e": "playwright test --workers=1",
    "coverage:comment": "tsx scripts/coverage-comment.ts",
    "data:fetch": "node --use-system-ca --import tsx scripts/fetch-sources.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data:fixture": "tsx scripts/build-fixture-data.ts",
    "data:precompress": "tsx scripts/precompress-dist-data.ts",
    "data:refresh": "node --use-system-ca --import tsx scripts/fetch-sources.ts --force --refresh-epoch && tsx scripts/build-data.ts",
    "data:pipeline": "npm run data:fetch && npm run data:build",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --exact-port --no-open",
    "build-storybook": "storybook build -o /tmp/starmap-storybook-static",
    "capture:views": "tsx scripts/capture-views.ts",
    "sync:discoveries": "tsx scripts/sync-discoveries.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.14",
    "@chromatic-com/storybook": "^5.6.0",
    "@react-three/test-renderer": "^9.1.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "csv-parser": "^3.2.1",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "storybook": "^10.6.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.2"
  }
}
